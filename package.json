{
  "name": "aec-s-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent Equilibrium Control System core infrastructure MVP",
  "bin": {
    "aec-s": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src test --deny-warnings",
    "test:unit": "node --test --test-concurrency=1 dist/test/*.test.js",
    "test": "npm run build && npm run test:unit",
    "test:coverage:built": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include='dist/src/**/*.js' --test-coverage-include-all --test-coverage-lines=80 --test-coverage-branches=65 --test-coverage-functions=80 dist/test/*.test.js",
    "test:coverage": "npm run build && npm run test:coverage:built",
    "test:all": "npm run lint && npm run check && npm run build && npm run test:coverage:built",
    "audit": "npm audit"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxlint": "^1.76.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
